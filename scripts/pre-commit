#!/usr/bin/env bash
# =============================================================================
# PRE-COMMIT HOOK — goqueue
# =============================================================================
#
# WHY PRE-COMMIT HOOKS?
# Catch issues BEFORE they hit CI. Faster feedback loop:
#
#   Without hook:  code → push → CI fails (5 min) → fix → push again
#   With hook:     code → commit blocked (10s) → fix → commit → CI passes
#
# COMPARISON:
#   - Kafka: Uses Spotless (Java formatter) in Gradle build
#   - NATS: Uses gofmt check in CI only
#   - CockroachDB: Pre-commit hooks for formatting + lint
#   - goqueue: Pre-commit for gofmt + vet + build (fast checks only)
#
# INSTALL:
#   cp scripts/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
#   Or run: make install-hooks
#
# WHAT THIS CHECKS:
#   1. gofmt — Code formatting (instant, non-negotiable)
#   2. go vet — Static analysis (fast, catches real bugs)
#   3. go build — Compilation check (must compile to commit)
#
# WHAT THIS DOES NOT CHECK (too slow for pre-commit):
#   - Full test suite (use CI)
#   - golangci-lint (use CI or run manually)
#   - Security scanning (use CI)
#
# =============================================================================

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Track if any check fails
FAILED=0

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 1: gofmt — Are all staged Go files formatted?
# ─────────────────────────────────────────────────────────────────────────────
#
# WHY: Unformatted Go code is a CI failure (golangci-lint enforces gofmt).
# Better to catch it here in <1s than wait 5 minutes for CI.
#
# HOW: Only check files that are staged (git diff --cached), not all files.
# This avoids checking unrelated files and keeps the hook fast.
# ─────────────────────────────────────────────────────────────────────────────

echo -n "  gofmt... "

# Get list of staged .go files (excluding deleted files)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    # Check if any staged Go files need formatting
    UNFORMATTED=$(echo "$STAGED_GO_FILES" | xargs gofmt -l 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        echo -e "${RED}FAIL${NC}"
        echo -e "  ${RED}The following files need gofmt:${NC}"
        echo "$UNFORMATTED" | while read -r file; do
            echo "    - $file"
        done
        echo -e "  ${YELLOW}Run: gofmt -w \$(git diff --cached --name-only -- '*.go')${NC}"
        FAILED=1
    else
        echo -e "${GREEN}OK${NC}"
    fi
else
    echo -e "${GREEN}OK (no Go files staged)${NC}"
fi

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 2: go vet — Static analysis for common bugs
# ─────────────────────────────────────────────────────────────────────────────
#
# WHAT go vet CATCHES:
#   - Printf format string mismatches
#   - Unreachable code
#   - Suspicious mutex usage
#   - Invalid struct tags
#   - Copy of sync values (sync.Mutex, sync.WaitGroup)
#
# WHY IN PRE-COMMIT:
#   go vet is fast (<5s) and catches real bugs that compile fine but
#   fail at runtime. It's the highest-value static check after gofmt.
# ─────────────────────────────────────────────────────────────────────────────

echo -n "  go vet... "
if go vet ./... 2>/dev/null; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo -e "  ${RED}go vet found issues. Run 'go vet ./...' for details.${NC}"
    FAILED=1
fi

# ─────────────────────────────────────────────────────────────────────────────
# CHECK 3: go build — Does the code compile?
# ─────────────────────────────────────────────────────────────────────────────
#
# WHY: Committing code that doesn't compile wastes everyone's time.
# This is the absolute minimum bar for any commit.
# ─────────────────────────────────────────────────────────────────────────────

echo -n "  go build... "
if go build ./... 2>/dev/null; then
    echo -e "${GREEN}OK${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo -e "  ${RED}Build failed. Run 'go build ./...' for details.${NC}"
    FAILED=1
fi

# ─────────────────────────────────────────────────────────────────────────────
# RESULT
# ─────────────────────────────────────────────────────────────────────────────

echo ""
if [ $FAILED -ne 0 ]; then
    echo -e "${RED}Pre-commit checks FAILED. Fix issues above before committing.${NC}"
    echo -e "${YELLOW}Tip: Use 'git commit --no-verify' to bypass (not recommended).${NC}"
    exit 1
else
    echo -e "${GREEN}All pre-commit checks passed.${NC}"
fi
